#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <assert.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include "byteutils.h"
/* INSERT_CURRENT_MIRROR_HELPERS_HERE */
static int cases;
int main(void) {
    assert(!valid_codec_payload(NULL, 0)); cases++;
    for (int size=0;size<256;size++) {
        unsigned char *p=calloc(size?size:1,1);
        assert(!valid_codec_payload(p,size)); free(p); cases++;
    }
    unsigned char h264[16]={0};h264[7]=2;h264[12]=3;
    assert(valid_codec_payload(h264,16));cases++;
    assert(!valid_codec_payload(h264,15));cases++;
    h264[6]=0xff;assert(!valid_codec_payload(h264,16));cases++;
    unsigned char h265[0x75+18]={0}; memcpy(h265+4,"hvc1",4);
    for(int i=0;i<3;i++)h265[0x75+i*6+4]=1;
    assert(valid_codec_payload(h265,sizeof(h265)));cases++;
    for(int size=8;size<(int)sizeof(h265);size++) {
        unsigned char *p=malloc(size);memcpy(p,h265,size);
        assert(!valid_codec_payload(p,size));free(p);cases++;
    }
    struct sockaddr_storage a={0},b={0};
    struct sockaddr_in *a4=(void*)&a,*b4=(void*)&b;
    a4->sin_family=b4->sin_family=AF_INET;
    a4->sin_addr.s_addr=b4->sin_addr.s_addr=htonl(0x7f000001);
    assert(same_mirror_peer(&a,&b));cases++;
    b4->sin_addr.s_addr=htonl(0x7f000002);assert(!same_mirror_peer(&a,&b));cases++;
    memset(&a,0,sizeof(a));memset(&b,0,sizeof(b));
    struct sockaddr_in6 *a6=(void*)&a,*b6=(void*)&b;
    a6->sin6_family=b6->sin6_family=AF_INET6;a6->sin6_addr.s6_addr[15]=b6->sin6_addr.s6_addr[15]=1;
    a6->sin6_scope_id=b6->sin6_scope_id=2;assert(same_mirror_peer(&a,&b));cases++;
    b6->sin6_scope_id=3;assert(!same_mirror_peer(&a,&b));cases++;
    b6->sin6_family=AF_INET;assert(!same_mirror_peer(&a,&b));cases++;
    printf("PASS: %d exact-source codec and peer boundary cases\n",cases);
}
