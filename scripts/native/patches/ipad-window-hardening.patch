+static bool
+same_mirror_peer(const struct sockaddr_storage *expected, const struct sockaddr_storage *actual)
+{
+    if (expected->ss_family != actual->ss_family) return false;
+    if (expected->ss_family == AF_INET) {
+        const struct sockaddr_in *a = (const struct sockaddr_in *) expected;
+        const struct sockaddr_in *b = (const struct sockaddr_in *) actual;
+        return a->sin_addr.s_addr == b->sin_addr.s_addr;
+    }
+    if (expected->ss_family == AF_INET6) {
+        const struct sockaddr_in6 *a = (const struct sockaddr_in6 *) expected;
+        const struct sockaddr_in6 *b = (const struct sockaddr_in6 *) actual;
+        return !memcmp(&a->sin6_addr, &b->sin6_addr, sizeof(a->sin6_addr)) &&
+               a->sin6_scope_id == b->sin6_scope_id;
+    }
+    return false;
+}
+
+/* Validate every codec offset before the existing parser dereferences it. */
+static bool
+valid_codec_payload(unsigned char *payload, int size)
+{
+    if (!payload || size < 8) return false;
+    if (!memcmp(payload + 4, "hvc1", 4)) {
+        int offset = 0x75;
+        for (int i = 0; i < 3; i++) {
+            if (offset > size - 5) return false;
+            int length = byteutils_get_short_be(payload, offset + 3);
+            if (length < 1 || length > 32767 || length > size - offset - 5) return false;
+            offset += 5 + length;
+        }
+        return true;
+    }
+    if (size < 11) return false;
+    int sps_size = byteutils_get_short_be(payload, 6);
+    if (sps_size < 1 || sps_size > 32767 || sps_size > size - 11) return false;
+    int pps_size = byteutils_get_short_be(payload, sps_size + 9);
+    return pps_size > 0 && pps_size <= 32767 && pps_size <= size - sps_size - 11;
+}
 
