+/* iPad to Mac Mirroring's receiver is intentionally a mirroring-only, ephemeral process.
+ * Reject options that could open arbitrary GStreamer pipelines or persist data
+ * before the upstream option parser can perform any file side effects. */
+static bool ipad_window_validate_arguments(int argc, char *argv[]) {
+    for (int i = 1; i < argc; ++i) {
+        std::string option(argv[i]);
+        if (option == "-nh" || option == "-pw" || option == "-m" ||
+            option == "-nofreeze" || option == "-h" || option == "-v") continue;
+        if (option != "-n" && option != "-s" && option != "-fps" &&
+            option != "-as" && option != "-vsync" && option != "-nc" &&
+            option != "-rc" && option != "-vs") return false;
+        if (++i >= argc || strlen(argv[i]) > 128) return false;
+        const std::string value(argv[i]);
+        if ((option == "-as" && value != "0") ||
+            (option == "-vsync" && value != "no") ||
+            (option == "-nc" && value != "no") ||
+            (option == "-rc" && value != "/dev/null") ||
+            (option == "-vs" && value != "glimagesink" && value != "osxvideosink")) return false;
+    }
+    return true;
+}
