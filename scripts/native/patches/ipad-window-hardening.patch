+static void ipad_window_event(const char *event, const char *value = NULL) {
+    const char *token = getenv("IPAD_WINDOW_EVENT_TOKEN");
+    if (!token || strlen(token) != 36) return;
+    for (const char *p = token; *p; ++p) {
+        if (!isxdigit((unsigned char) *p) && *p != '-') return;
+    }
+    flockfile(stdout);
+    printf("IPADWINDOW_EVENT %s %s%s%s\n", token, event,
+           value ? " " : "", value ? value : "");
+    fflush(stdout);
+    funlockfile(stdout);
+}
