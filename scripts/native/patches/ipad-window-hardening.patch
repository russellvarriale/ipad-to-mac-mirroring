+int x25519_derive_secret(unsigned char secret[X25519_KEY_SIZE], const x25519_key_t *ours, const x25519_key_t *theirs) {
+    /* A network peer can supply a low-order public key. Reject it as input;
+     * do not terminate the receiver through the generic crypto error handler. */
+    if (!secret) return -1;
+    memset(secret, 0, X25519_KEY_SIZE);
+    if (!ours || !theirs || !ours->pkey || !theirs->pkey) return -1;
+    EVP_PKEY_CTX *pctx = EVP_PKEY_CTX_new(ours->pkey, NULL);
+    if (!pctx) return -1;
+    size_t length = X25519_KEY_SIZE;
+    int result = -1;
+    if (EVP_PKEY_derive_init(pctx) > 0 &&
+        EVP_PKEY_derive_set_peer(pctx, theirs->pkey) > 0 &&
+        EVP_PKEY_derive(pctx, secret, &length) > 0 && length == X25519_KEY_SIZE) {
+        result = 0;
     }
     EVP_PKEY_CTX_free(pctx);
+    if (result) {
+        memset(secret, 0, X25519_KEY_SIZE);
+        ERR_clear_error();
+    }
+    return result;
 }
 
